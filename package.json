{
  "name": "image-to-jpg",
  "version": "1.6.1",
  "description": "Batch image converter with MyGO desktop UI and CLI for macOS and Windows",
  "bin": {
    "batch-image-processor": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node scripts/desktop.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "cli": "node src/cli/index.js",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "build": "node scripts/desktop.mjs build",
    "build:mac": "node scripts/desktop.mjs build -platform darwin/arm64,darwin/amd64",
    "build:win": "node scripts/desktop.mjs build -platform windows/amd64",
    "build:linux": "node scripts/desktop.mjs build -platform linux/amd64",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:go": "go test ./...",
    "check": "npm test -- --runInBand && go test ./... && npm run build:web",
    "build:cli": "node scripts/build-cli.mjs",
    "build:cli:mac": "node scripts/build-cli.mjs darwin/arm64,darwin/amd64",
    "build:cli:win": "node scripts/build-cli.mjs windows/amd64",
    "test:cli": "jest --runInBand __tests__/cli.test.js",
    "build:all": "node scripts/desktop.mjs build -platform darwin/arm64,darwin/amd64,windows/amd64",
    "clean": "node scripts/clean.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "commander": "^14.0.0",
    "heic-decode": "2.1.0",
    "mygo-runtime": "0.8.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "jest": "^30.0.4",
    "mygo-cli": "0.8.3",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
