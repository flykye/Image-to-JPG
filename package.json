{
  "name": "image-to-jpg",
  "version": "1.0.0",
  "description": "Batch image processor for HEIC, LIVP, PNG files with Electron GUI",
  "main": "main.js",
  "bin": {
    "batch-image-processor": "./batch-processor.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node batch-processor.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "build": {
    "appId": "com.livp.imageprocessor",
    "productName": "Image to JPG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "batch-processor.js",
      "heic-converter.js",
      "livp.js",
      "file-manager.js",
      "progress-reporter.js",
      "error-handler.js",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^14.0.0",
    "dmg-license": "^1.0.11",
    "heic-convert": "^2.1.0",
    "sharp": "^0.34.5"
  },
  "packageManager": "yarn@4.5.0+sha512.837566d24eec14ec0f5f1411adb544e892b3454255e61fdef8fd05f3429480102806bac7446bc9daff3896b01ae4b62d00096c7e989f1596f2af10b927532f39",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "26.0.12",
    "jest": "^30.0.4"
  }
}
