{
  "name": "image-to-jpg",
  "version": "1.0.0",
  "description": "Batch image processor for HEIC, LIVP, PNG files with Electron GUI",
  "main": "src/ui/main/index.js",
  "bin": {
    "batch-image-processor": "./src/cli/index.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli/index.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "build": {
    "appId": "com.livp.imageprocessor",
    "productName": "Image to JPG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^14.0.0",
    "dmg-license": "^1.0.11",
    "electron-store": "^11.0.2",
    "heic-convert": "^2.1.0",
    "sharp": "^0.34.5"
  },

  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "26.0.12",
    "jest": "^30.0.4"
  }
}
